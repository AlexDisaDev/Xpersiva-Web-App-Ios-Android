{
  "expo": {
    "name": "Xpersiva",
    "slug": "xpersiva",
    "scheme": "xpersiva",
    "version": "0.1.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#FFFFFF",
    "ios": {
      "bundleIdentifier": "app.xpersiva.player",
      "supportsTablet": false,
      "associatedDomains": [
        "applinks:xpersiva.netlify.app"
      ],
      "infoPlist": {
        "NSLocalNetworkUsageDescription": "Xpersiva se conecta a la experiencia del evento a través de la red Wi-Fi local.",
        "NSAppTransportSecurity": {
          "NSAllowsLocalNetworking": true
        }
      }
    },
    "android": {
      "package": "app.xpersiva.player",
      "adaptiveIcon": {
        "backgroundColor": "#FFFFFF",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "intentFilters": [
        {
          "action": "VIEW",
          "autoVerify": true,
          "data": [
            {
              "scheme": "https",
              "host": "xpersiva.netlify.app",
              "pathPrefix": "/j/"
            },
            {
              "scheme": "https",
              "host": "xpersiva.netlify.app",
              "pathPrefix": "/e/"
            }
          ],
          "category": [
            "BROWSABLE",
            "DEFAULT"
          ]
        }
      ],
      "predictiveBackGestureEnabled": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      [
        "expo-camera",
        {
          "cameraPermission": "Xpersiva usa la cámara solo para escanear el código QR de la experiencia.",
          "microphonePermission": false,
          "recordAudioAndroid": false
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Xpersiva usa tu ubicación solo para enseñarte primero las experiencias que tienes más cerca.",
          "isAndroidBackgroundLocationEnabled": false,
          "isIosBackgroundLocationEnabled": false
        }
      ],
      [
        "expo-build-properties",
        {
          "android": {
            "usesCleartextTraffic": true
          }
        }
      ]
    ],
    "experiments": {
      "typedRoutes": false
    }
  }
}